<div class="container mt-4">
    <h3 class="mb-4 fw-bold text-primary">
        <i class="bx bx-cog"></i> Cart 테이블 총괄 관리 (Admin)
    </h3>
    
    <table class="table table-bordered border-primary table-hover align-middle" style="text-align: center;">
        <thead class="table-primary">
            <tr>
                <th style="width: 12%;">고객 ID (loginid)</th>
                <th style="width: 12%;">고객명</th>
                <th style="width: 10%;">상품 ID</th>
                <th>상품명</th>
                <th style="width: 22%;">담은 일자</th>
                <th style="width: 8%;">수정</th>
                <th style="width: 8%;">삭제</th>
            </tr>
        </thead> 
        <tbody>
            <% if (typeof results !== 'undefined' && results && results.length > 0) { %>
                <% results.forEach((cart) => { %>
                    <tr>
                        <td><code><%= cart.loginid %></code></td>
                        <td class="fw-bold text-secondary"><%= cart.user_name %></td>
                        <td><%= cart.prod_id %></td>
                        <td class="text-start ps-3"><%= cart.prod_name %></td>
                        <td class="text-muted" style="font-size: 0.9rem;"><%= cart.date %></td>
                        
                        <td>
                            <a href="/purchase/cartupdate/<%= cart.cart_id %>" class="btn btn-sm btn-outline-success px-3" style="text-decoration: none;">
                                <i class="bx bx-edit"></i> 수정
                            </a>
                        </td>
                        
                        <td>
                            <a href="/purchase/cartdelete_process?admin=Y&cart_id=<%= cart.cart_id %>" 
                               class="btn btn-sm btn-outline-danger px-3" 
                               style="text-decoration: none;" 
                               onclick="return confirm('관리자 권한으로 해당 카트 내역을 정말로 삭제하시겠습니까?');">
                                <i class="bx bx-trash"></i> 삭제
                            </a>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="7" class="py-5 text-muted">
                        <i class="bx bx-info-circle fs-3"></i><br>
                        현재 활성화된 전체 사용자 장바구니 내역 데이터가 존재하지 않습니다.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <div class="mt-3 text-end">
        <a href="/" class="btn btn-sm btn-outline-secondary px-3" style="text-decoration: none;">
            <i class="bx bx-home"></i> 메인화면으로 복귀
        </a>
    </div>
</div>
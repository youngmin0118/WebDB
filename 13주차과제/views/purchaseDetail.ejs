<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header table-primary fw-bold text-dark">
            <i class="bx bx-credit-card-front"></i> 상품 상세 정보
        </div>
        <div class="card-body p-4">
            <% if (typeof result !== 'undefined' && result) { %>
                <table class="table table-bordered align-middle m-0">
                    <tr>
                        <td rowspan="6" style="width: 340px; text-align: center;" class="bg-light">
                            <% if (result.image) { %>
                                <img src="/images/<%= result.image %>" style="width:300px; height:300px; object-fit: cover;" class="rounded border shadow-sm">
                            <% } else { %>
                                <div class="d-flex flex-column justify-content-center align-items-center rounded border bg-white" style="width:300px; height:300px;">
                                    <span class="text-muted">이미지 없음</span>
                                </div>
                            <% } %>
                        </td>
                        <td class="fw-bold fs-4 p-3 text-dark"><%= result.name %></td>
                    </tr>
                    <tr>
                        <td class="p-3 fs-5">가격 : <strong class="text-danger"><%= result.price %></strong> 원</td>
                    </tr>
                    <tr>
                        <td class="p-3 text-secondary">브랜드 : <%= result.brand %></td>
                    </tr>
                    <tr>
                        <td class="p-3 text-secondary">공급업체 : <%= result.supplier %></td>
                    </tr>

                    <% if (cls !== 'MNG' && cls !== 'CEO' && cls !== 'admin') { %>
                        <tr>
                            <td class="p-3 bg-light-subtle">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="fw-bold text-secondary">수량</span>
                                    <script>
                                        function syncQty(val) {
                                            document.getElementById('pay_qty').value = val;
                                        }
                                    </script>
                                    <input type="number" value="1" min="1" onchange="syncQty(this.value)" class="form-control text-center shadow-sm" style="width: 100px; font-weight: bold;">
                                    <span class="text-muted">개</span>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3">
                                <div class="d-flex gap-2 mt-2">
                                    <form action="/purchase/pay_process" method="POST" class="m-0">
                                        <input type="hidden" name="prod_id" value="<%= result.prod_id %>">
                                        <input type="hidden" name="price" value="<%= result.price %>">
                                        <input type="hidden" name="qty" id="pay_qty" value="1">
                                        <button class="btn btn-primary px-4 shadow-sm" type="submit">
                                            <i class="bx bx-credit-card"></i> 바로구매
                                        </button>
                                    </form>

                                    <form action="/purchase/cart_process" method="POST" class="m-0">
                                        <input type="hidden" name="prod_id" value="<%= result.prod_id %>">
                                        <button class="btn btn-outline-primary px-4" type="submit">
                                            <i class="bx bx-cart"></i> 장바구니
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% } else { %>
                        <tr>
                            <td colspan="2" class="p-4 text-center bg-light">
                                <span class="text-danger fw-bold"><i class="bx bx-lock-alt"></i> 관리자(MNG) 및 경영자(CEO)는 상품을 구매할 수 없습니다.</span>
                            </td>
                        </tr>
                    <% } %>
                </table>

                <div class="mt-3 text-end">
                    <a href="/" class="btn btn-outline-secondary px-3" style="text-decoration: none;">
                        <i class="bx bx-home"></i> 메인화면으로 복귀
                    </a>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <p class="text-muted mb-0">상품 데이터를 정상적으로 불러오지 못했습니다.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>
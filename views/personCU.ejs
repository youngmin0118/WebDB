<div class="container" style="max-width: 600px; margin-top: 30px;">
    <% if (typeof person !== 'undefined') { %>
        <h2 class="mb-4">관리자 기능 : 회원 정보 수정</h2>
        <form action="/person/update_process" method="post">
            <input type="hidden" name="loginid" value="<%= person.loginid %>">
            <div class="mb-3">
                <label class="form-label">ID</label>
                <input class="form-control" type="text" value="<%= person.loginid %>" disabled />
            </div>
    <% } else { %>
        <h2 class="mb-4">관리자 기능 : 회원 생성</h2>
        <form action="/person/create_process" method="post">
            <div class="mb-3">
                <label class="form-label">ID</label>
                <input class="form-control" type="text" name="loginid" placeholder="아이디를 입력해 주세요" required />
            </div>
    <% } %>

            <div class="mb-3">
                <label class="form-label">PW</label> 
                <input class="form-control" type="password" name="password" 
                       value="<%= (typeof person !== 'undefined') ? person.password : '' %>" required />
            </div>

            <div class="mb-3">
                <label class="form-label">이름</label> 
                <input class="form-control" type="text" name="name" 
                       value="<%= (typeof person !== 'undefined') ? person.name : '' %>" required />
            </div>

            <div class="mb-3">
                <label class="form-label">성별</label>&nbsp;&nbsp;
                <input type="radio" name="mf" value="M" <%= (typeof person !== 'undefined' && person.mf === 'M') ? 'checked' : '' %> /> 남자
                &nbsp;&nbsp;
                <input type="radio" name="mf" value="F" <%= (typeof person !== 'undefined' && person.mf === 'F') ? 'checked' : '' %> /> 여자
            </div>

            <div class="mb-3">
                <label class="form-label">주소</label> 
                <input class="form-control" type="text" name="address" 
                       value="<%= (typeof person !== 'undefined') ? person.address : '' %>" />
            </div>

            <div class="mb-3">
                <label class="form-label">전화번호</label> 
                <input class="form-control" type="text" name="tel" placeholder="000-0000-0000" 
                       value="<%= (typeof person !== 'undefined') ? person.tel : '' %>" />
            </div>

            <div class="mb-3">
                <label class="form-label">생일</label> 
                <input class="form-control" type="text" name="birth" placeholder="YYYYMMDD" 
                       value="<%= (typeof person !== 'undefined') ? person.birth : '' %>" required />
            </div>

            <div class="mb-3">
                <label class="form-label">CLASS</label>
                <select name="class" class="form-select">
                    <option value="CST" <%= (typeof person !== 'undefined' && person.class === 'CST') ? 'selected' : '' %>>고객 (CST)</option>
                    <option value="MNG" <%= (typeof person !== 'undefined' && person.class === 'MNG') ? 'selected' : '' %>>관리자 (MNG)</option>
                    <option value="CEO" <%= (typeof person !== 'undefined' && person.class === 'CEO') ? 'selected' : '' %>>경영자 (CEO)</option>
                </select>
            </div>

            <div class="mt-4">
                <button class="btn btn-primary" type="submit"><%= (typeof person !== 'undefined') ? '수정' : '입력' %></button>
                
                <% if (typeof cls !== 'undefined' && cls === 'MNG') { %>
                    <a href="/person/view" class="btn btn-outline-secondary">돌아가기</a>
                <% } else { %>
                    <a href="/" class="btn btn-outline-secondary">돌아가기</a>
                <% } %>
            </div>
        </form>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    // 체크박스 선택 시 개수를 카운트하여 hidden input(#total)에 저장하는 함수
    function actionCheck(event) {
        var tempOfCheck = 0;
        $("input[name=check]:checked").each(function() {
            tempOfCheck += 1;
        });
        
        var numOfCheck = document.getElementById('total');
        if (tempOfCheck > 0) {
            numOfCheck.value = tempOfCheck;
        } else {
            numOfCheck.value = 0;
        }
    }
</script>

<div class="container mt-3">
    <h3 class="mb-4"><i class="bx bx-cart"></i> 장바구니 목록</h3>
    
    <form method="post">
        <input type="hidden" id="total" name="numOfCheck" value="0">

        <table class="table table-bordered table-hover align-middle" style="text-align: center;">
            <thead class="table-primary">
                <tr>
                    <th style="width: 10%;">구매선택</th>
                    <th style="width: 15%;">상품</th>
                    <th>상품명</th>
                    <th style="width: 15%;">단가</th>
                    <th style="width: 20%;">담은날</th>
                    <th style="width: 12%;">수량</th>
                </tr>
            </thead>
            <tbody>
            <% if (results && results.length > 0) { %>
                <% results.forEach((item) => { %>
                    <tr>
                        <td>
                            <input type="checkbox" name="check" value="<%= item.cart_id %>" onchange="actionCheck(event)">
                        </td>
                        
                        <td>
                            <% if (item.image) { %>
                                <a href="/purchase/detail/<%= item.prod_id %>">
                                    <img src="/images/<%= item.image %>" style="width:80px; height:80px; object-fit:cover;" class="rounded shadow-sm">
                                </a>
                            <% } else { %>
                                <a href="/purchase/detail/<%= item.prod_id %>" style="text-decoration: none;">
                                    <span class="text-muted" style="font-size: 0.85rem;">이미지 없음</span>
                                </a>
                            <% } %>
                        </td>
                        
                        <td class="text-start fw-bold ps-3">
                            <a href="/purchase/detail/<%= item.prod_id %>" class="text-dark text-decoration-none">
                                <%= item.name %>
                            </a>
                        </td>
                        
                        <td><strong class="text-danger"><%= item.price %></strong> 원</td>
                        
                        <td class="text-muted" style="font-size: 0.85rem;"><%= item.date %></td>
                        
                        <td>
                            <input type="number" name="qty_<%= item.cart_id %>" value="1" min="1" class="form-control form-control-sm text-center mx-auto" style="width: 70px; font-weight: bold;">
                        </td> 
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="py-5 text-muted">
                        <i class="bx bx-info-circle fs-3"></i><br>
                        장바구니에 담긴 상품이 없습니다.
                    </td>
                </tr>
            <% } %>
        </tbody>
        </table>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-outline-primary btn-sm px-4" type="submit" 
                    formaction="/purchase/cart_to_purchase_process" 
                    onclick="if(document.getElementById('total').value == '0'){ alert('구매할 상품을 선택해 주세요'); return false; }">
                결제
            </button>
            
            <button class="btn btn-outline-danger btn-sm px-4" type="submit" 
                    formaction="/purchase/cartdelete_process" 
                    onclick="if(document.getElementById('total').value == '0'){ alert('삭제할 상품을 선택해 주세요'); return false; } else { return confirm('정말로 삭제하시겠습니까?'); }">
                삭제
            </button>
            
            <a href="/" class="btn btn-outline-secondary btn-sm px-4" style="text-decoration: none;">상품 목록 돌아가기</a>
        </div>
    </form>
</div>
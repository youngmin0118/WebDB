<div class="container mt-4" style="max-width: 600px;">	
    <h2 class="mb-4 fw-bold text-success">
        <i class="bx bx-edit"></i> cart 테이블 정보 수정 (Admin)
    </h2>
    
    <form action="/purchase/cartupdate_process" method="post" class="card p-4 shadow-sm bg-light">
        
        <input type="hidden" name="cart_id" value="<%= cart.cart_id %>" />

        <div class="mb-3">
            <label class="form-label fw-bold" for="loginid"><i class="bx bx-user"></i> 담은 고객 선택</label> 
            <select name="loginid" id="loginid" class="form-select" required>
                <% if (persons && persons.length > 0) { %>
                    <% persons.forEach((person) => { %>
                        <option value="<%= person.loginid %>" <%= (cart.loginid === person.loginid) ? 'selected' : '' %>>
                            <%= person.name %> (<%= person.loginid %>)
                        </option>
                    <% }) %>
                <% } else { %>
                    <option value="">등록된 사용자가 없습니다.</option>
                <% } %>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" for="prod_id"><i class="bx bx-package"></i> 담은 상품 선택</label> 
            <select name="prod_id" id="prod_id" class="form-select" required>
                <% if (products && products.length > 0) { %>
                    <% products.forEach((prod) => { %>
                        <option value="<%= prod.prod_id %>" <%= (cart.prod_id === prod.prod_id) ? 'selected' : '' %>>
                            <%= prod.name %> (ID: <%= prod.prod_id %>)
                        </option>
                    <% }) %>
                <% } else { %>
                    <option value="">등록된 상품이 없습니다.</option>
                <% } %>
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold" for="date"><i class="bx bx-calendar"></i> 최초 장바구니 등록 일자</label> 
            <input class="form-control text-muted" type="text" name="date" id="date" value="<%= cart.date %>" readonly style="background-color: #e9ecef;" />
            <div class="form-text">※ 장바구니 등록 시각은 시스템 보안 및 기록 보존을 위해 수정이 불가합니다.</div>
        </div>
        
        <div class="d-flex gap-2 justify-content-end">
            <button class="btn btn-success px-4" type="submit">
                <i class="bx bx-check"></i> 수정 완료
            </button>
            <a href="/table/view/cart" class="btn btn-outline-secondary px-3" style="text-decoration: none;">
                <i class="bx bx-arrow-back"></i> 카트 목록 돌아가기
            </a>
        </div>
    </form>
</div>
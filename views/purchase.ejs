<div class="container mt-3">
    <h3 class="mb-4"><i class="bx bx-receipt"></i> 나의 구매 내역</h3>
    
    <table class="table table-bordered table-hover align-middle" style="text-align: center;">
        <thead class="table-dark">
            <tr>
                <th style="width: 15%;">상품</th>
                <th>상품명</th>
                <th style="width: 12%;">단가</th>
                <th style="width: 10%;">구매량</th>
                <th style="width: 15%;">총금액</th>
                <th style="width: 20%;">구매일</th>
                <th style="width: 13%;">취소여부</th>
            </tr>
        </thead>
        <tbody>
            <% if (results && results.length > 0) { %>
                <% results.forEach((item) => { %>
                    <tr>
                        <td>
                            <% if (item.image) { %>
                                <a href="/purchase/detail/<%= item.prod_id %>">
                                    <img src="/images/<%= item.image %>" style="width:80px; height:80px; object-fit:cover;" class="rounded">
                                </a>
                            <% } else { %>
                                <span class="text-muted" style="font-size: 0.85rem;">이미지 없음</span>
                            <% } %>
                        </td>
                        
                        <td class="text-start fw-bold ps-3">
                            <a href="/purchase/detail/<%= item.prod_id %>" class="text-decoration-none text-dark link-primary">
                                <%= item.name %>
                            </a>
                        </td>
                        
                        <td><span class="text-secondary"><%= item.price.toLocaleString() %></span>원</td>
                        
                        <td><span class="badge bg-light text-dark border px-2"><%= item.qty %> 개</span></td>
                        
                        <td><span class="text-danger fw-bold"><%= item.total.toLocaleString() %></span>원</td>
                        
                        <td class="text-muted" style="font-size: 0.85rem;"><%= item.date %></td>
                        
                        <td>
                            <% if (item.cancel === 'Y') { %>
                                <span class="badge bg-danger px-2 py-1.5" style="font-size: 0.85rem;">
                                    <i class="bx bx-x-circle"></i> 취소된 상품
                                </span>
                            <% } else { %>
                                <a href="/purchase/cancel/<%= item.purchase_id %>" 
                                   class="btn btn-sm btn-outline-warning fw-bold px-2.5" 
                                   style="text-decoration: none;"
                                   onclick="return confirm('정말로 이 상품의 구매를 취소하시겠습니까?');">
                                    <i class="bx bx-undo"></i> 구매취소
                                </a>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="7" class="py-5 text-muted">
                        <i class="bx bx-receipt fs-2"></i><br>
                        고객님의 최근 주문 및 최종 구매 내역 정보가 존재하지 않습니다.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <div class="mt-3 text-end">
        <a href="/" class="btn btn-sm btn-outline-secondary px-3" style="text-decoration: none;">
            <i class="bx bx-shopping-bag"></i> 계속 쇼핑하기
        </a>
    </div>
</div>
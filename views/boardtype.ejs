<div class="container" style="margin-top: 30px;">
    <h2 class="mb-4">게시판 종류 관리</h2>
    
    <table class="table table-bordered border-primary table-hover" style="text-align: center;">
        
        <thead class="table-primary">
            <tr>
                <th>제목</th>
                <th>페이지당 글 수</th>
                <th>설명</th>
                <th>일반 사용자 쓰기</th>
                <th>댓글</th>
                
                <% if (cls === 'MNG') { %>
                    <th colspan="2">관리</th>
                <% } %>
            </tr>
        </thead> 
        
        <tbody>
            <% if (results && results.length > 0) { %>
                
                <% for(var i = 0; i < results.length; i++) { %>
                    <tr>
                        <td><%= results[i].title %></td>
                        <td><%= results[i].numPerPage %></td>
                        <td><%= results[i].description %></td>
                        <td><%= results[i].write_YN %></td>
                        <td><%= results[i].re_YN %></td>
                        
                        <% if (cls === 'MNG') { %>
                            <td>
                                <a href="/board/type/update/<%= results[i].type_id %>" class="btn btn-sm btn-outline-success">수정</a>
                            </td>
                            <td>
                                <a href="/board/type/delete/<%= results[i].type_id %>" 
                                   class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('정말로 삭제하시겠습니까?')">삭제</a>
                            </td>
                        <% } %>
                    </tr>
                <% } %>
                
            <% } else { %>
                <tr>
                    <td colspan="<%= (cls === 'MNG') ? 7 : 5 %>" class="py-4 text-secondary">
                        자료가 없으니 게시판 종류 추가 버튼으로 코드를 추가해 주십시오.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table> <div class="d-flex justify-content-between align-items-center mt-3">
        
        <div>
            <% if (cls === 'MNG') { %>
                <a href="/board/type/create" class="btn btn-outline-secondary btn-sm">게시판 종류 추가</a>
            <% } else { %>
                &nbsp;
            <% } %>
        </div>

        <div>
            <a href="/" class="btn btn-sm btn-outline-secondary px-3" style="text-decoration: none;">
                <i class="bx bx-home"></i> 메인화면으로 복귀
            </a>
        </div>
        
    </div>
</div>
<div class="container" style="max-width: 600px; margin-top: 30px;">
    <script>
        // 파일 선택 시 선택된 파일명을 텍스트 박스에 표시해주는 함수 
        function displayFileName(){
            var fileInput = document.getElementById('file');
            var fileName = fileInput.files[0] ? fileInput.files[0].name : "";
            document.querySelector(".upload-name").value = fileName;
        }
    </script>

    <% if (typeof product !== 'undefined') { %>
        <h2 class="mb-4">상품 수정</h2>
        <form action="/product/update_process" method="post" enctype="multipart/form-data">
            <input type="hidden" name="prod_id" value="<%= product.prod_id %>">

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">카테고리</label> 
                <select name="category" id="id_main" class="form-select">
                    <% if (typeof results2 !== 'undefined') { %>
                        <% for(var i=0; i < results2.length; i++) { %>
                            <% 
                               // 대분류:소분류 형태로 value를 구성하여 서버에서 분리할 수 있게 함
                               var combinedId = results2[i].main_id + ":" + results2[i].sub_id;
                               var isSelected = (product.sub_id === results2[i].sub_id) ? 'selected' : ''; 
                            %>
                            <option value="<%= combinedId %>" <%= isSelected %>>
                                <%= results2[i].main_name %> : <%= results2[i].sub_name %>
                            </option>
                        <% } %>
                    <% } else { %>
                        <option value="">카테고리 로드 실패</option>
                    <% } %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">제품명</label> 
                <input class="form-control" type="text" name="name" value="<%= product.name %>" required />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">가격</label> 
                <input class="form-control" type="text" name="price" value="<%= product.price %>" required />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">재고</label> 
                <input class="form-control" type="text" name="stock" value="<%= product.stock %>" />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">브랜드</label> 
                <input class="form-control" type="text" name="brand" value="<%= product.brand %>" />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">공급자</label> 
                <input class="form-control" type="text" name="supplier" value="<%= product.supplier %>" />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">상품 이미지 (변경 시에만 선택)</label>
                <div class="input-group">
                    <input class="form-control upload-name" placeholder="기존 파일: <%= product.image %>" readonly>
                    <input type="file" id="file" name="uploadFile" class="form-control" onchange="displayFileName()">
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">수정 완료</button>
                <a href="/product/view" class="btn btn-secondary">제품목록 돌아가기</a>
            </div>
        </form>

    <% } else { %>
        <h2 class="mb-4">상품 입력</h2>
        <form action="/product/create_process" method="post" enctype="multipart/form-data">
            
            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">카테고리</label> 
                <select name="category" id="id_main" class="form-select">
                    <% if (typeof results2 !== 'undefined') { %>
                        <% for(var i=0; i < results2.length; i++) { %>
                            <option value="<%= results2[i].main_id %>:<%= results2[i].sub_id %>">
                                <%= results2[i].main_name %> : <%= results2[i].sub_name %>
                            </option>
                        <% } %>
                    <% } else { %>
                        <option value="">카테고리 로드 실패</option>
                    <% } %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">제품명</label> 
                <input class="form-control" type="text" name="name" required />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">가격</label> 
                <input class="form-control" type="text" name="price" required />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">재고</label> 
                <input class="form-control" type="text" name="stock" />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">브랜드</label> 
                <input class="form-control" type="text" name="brand" />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">공급자</label> 
                <input class="form-control" type="text" name="supplier" />
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold;">이미지 파일</label>
                <div class="input-group">
                    <input class="form-control upload-name" placeholder="파일을 선택하세요" readonly>
                    <input type="file" id="file" name="uploadFile" class="form-control" onchange="displayFileName()" required>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">입력</button>
                <a href="/product/view" class="btn btn-secondary">제품목록 돌아가기</a>
            </div>
        </form>
    <% } %>
</div>
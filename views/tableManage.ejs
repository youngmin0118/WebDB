<div class="container">
    <h2 class="mb-4">데이터베이스 메타데이터 테이블 관리</h2>
    
    <table class="table table-bordered border-primary table-hover align-middle" style="text-align: center;">
        <thead class="table-primary">
            <tr>
                <th style="width: 35%;">테이블 명</th>
                <th style="width: 65%;">테이블 설명</th>
            </tr>
        </thead> 
        <tbody>
            <% if (results && results.length > 0) { %>
                <% results.forEach((table) => { %>
                    <tr>
                        <td class="fw-bold">
                            <a href="/table/view/<%= table.TABLE_NAME %>" class="text-decoration-none text-primary">
                                <%= table.TABLE_NAME %>
                            </a>
                        </td>
                        <td class="text-start ps-4 text-muted">
                            <%= table.TABLE_COMMENT ? table.TABLE_COMMENT : '설명이 등록되지 않은 테이블입니다.' %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="2" class="py-4 text-secondary">조회된 데이터베이스 내 물리 테이블 정보가 존재하지 않습니다.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">

        <div>
            <a href="/" class="btn btn-sm btn-outline-secondary px-3" style="text-decoration: none;">
                <i class="bx bx-home"></i> 메인화면으로 복귀
            </a>
        </div>
    </div>
</div>
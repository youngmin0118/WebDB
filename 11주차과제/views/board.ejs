<div class="container mt-3">
    <h3><%= btname[0].title %></h3>
    <table class="table table-hover">
        <thead>
            <tr>
                <th style="width: 45%;">제목</th>
                <th style="width: 15%;">작성자</th>
                <th style="width: 20%;">날짜</th>
                <th style="width: 20%;">관리</th>
            </tr>
        </thead>
        <tbody>
            <% results.forEach((post) => { %>
                <tr>
                    <td><%= post.title %></td>
                    <td><%= post.author_name || '익명' %></td>
                    <td><%= post.date %></td>
                    <td>
                        <% if (cls === 'MNG' || (who_id === post.loginid)) { %>
                            <a href="/board/update/<%= post.board_id %>/<%= typeId %>/<%= pNum %>" 
                               class="btn btn-sm btn-outline-warning">수정</a>
                            
                            <a href="/board/delete/<%= post.board_id %>/<%= typeId %>/<%= pNum %>" 
                               class="btn btn-sm btn-outline-danger" 
                               onclick="return confirm('정말 삭제하시겠습니까?')">삭제</a>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <div class="d-flex justify-content-between mt-3">
        <div>
            <% if (btname[0].title === '공지사항') { %>
                <% if (cls === 'MNG') { %>
                    <a href="/board/create/<%= typeId %>" class="btn btn-primary">글쓰기</a>
                <% } %>
            <% } else { %>
                <% if (cls === 'MNG' || btname[0].write_YN === 'Y') { %>
                    <a href="/board/create/<%= typeId %>" class="btn btn-primary">글쓰기</a>
                <% } %>
            <% } %>
        </div>
        
        <nav>
            <ul class="pagination mb-0">
                <% for(let i=1; i <= totalPages; i++) { %>
                    <li class="page-item <%= (Number(pNum) === i) ? 'active' : '' %>">
                        <a class="page-link" href="/board/view/<%= typeId %>/<%= i %>"><%= i %></a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>
</div>
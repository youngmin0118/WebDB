<div class="container" style="margin-top: 30px;">
    <h2 class="mb-4">상품 관리</h2>
    
    <table class="table table-bordered border-primary table-hover" style="text-align: center; vertical-align: middle;">
        <thead class="table-primary">
            <tr>
                <th>이미지</th>
                <th>상품명</th>
                <th>가격</th>
                <th>재고</th>
                <th>브랜드</th>
                <th>공급처</th>
                <% if (cls === 'MNG' || cls === 'admin') { %>
                    <th colspan="2">관리</th>
                <% } %>
            </tr>
        </thead>
        <tbody>
            <% if (results && results.length > 0) { %>
                <% for(var i = 0; i < results.length; i++) { %>
                    <tr>
                        <td>
                            <% if (results[i].image) { %>
                                <img src="/images/<%= results[i].image %>" alt="<%= results[i].name %>" style="width: 50px; height: auto;">
                            <% } else { %>
                                <span class="text-muted">이미지 없음</span>
                            <% } %>
                        </td>
                        <td><%= results[i].name %></td>
                        <td><%= results[i].price.toLocaleString() %>원</td>
                        <td><%= results[i].stock %>개</td>
                        <td><%= results[i].brand %></td>
                        <td><%= results[i].supplier %></td>
                        
                        <% if (cls === 'MNG' || cls === 'admin') { %>
                            <td>
                                <a href="/product/update/<%= results[i].prod_id %>" class="btn btn-sm btn-outline-success">수정</a>
                            </td>
                            <td>
                                <a href="/product/delete/<%= results[i].prod_id %>" 
                                   class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('정말로 이 상품을 삭제하시겠습니까?')">삭제</a>
                            </td>
                        <% } %>
                    </tr>
                <% } %>
            <% } else { %>
                <tr>
                    <td colspan="<%= (cls === 'MNG' || cls === 'admin') ? 8 : 6 %>" class="py-4 text-secondary">
                        등록된 상품이 없습니다. 상품 추가 버튼을 이용해 상품을 등록해 주세요.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <% if (cls === 'MNG' || cls === 'admin') { %>
        <div class="mt-3">
            <a href="/product/create" class="btn btn-outline-secondary btn-sm">상품 추가</a>
        </div>
    <% } %>
</div>
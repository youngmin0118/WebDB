<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href='https://unpkg.com/boxicons@2.0.7/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css"> 
</head>
<body>
    <div class="sidebar close">
        <div class="logo-details">
            <i class='bx bxl-c-plus-plus'></i>
            <span class="logo_name">GCShop</span>
        </div>
        <ul class="nav-links">
            <li>
                <a href="/">
                    <i class='bx bx-grid-alt'></i>
                    <span class="link_name">Dashboard</span>
                </a>
                <ul class="sub-menu blank">
                    <li><a class="link_name" href="/">Dashboard</a></li>
                </ul>
            </li>

            <li>
                <div class="icon-link">
                    <a href="/product/view">
                        <i class='bx bx-collection'></i>
                        <span class="link_name">Category</span>
                    </a>
                    <i class='bx bxs-chevron-down arrow'></i>
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="/product/view">All Products</a></li>
                    <% if (typeof categoryList !== 'undefined' && categoryList.length > 0) { %>
                        <% categoryList.forEach(cat => { %>
                            <li><a href="/product/category/<%= cat.main_id %>/<%= cat.sub_id %>"><%= cat.sub_name %></a></li>
                        <% }) %>
                    <% } %>
                </ul>
            </li>

            <li>
                <div class="icon-link">
                    <a href="#">
                        <i class='bx bx-book-alt'></i>
                        <span class="link_name">Board</span>
                    </a>
                    <i class='bx bxs-chevron-down arrow'></i>
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Board Types</a></li>
                    <% if (typeof boardtypes !== 'undefined' && boardtypes.length > 0) { %>
                        <% boardtypes.forEach(bt => { %>
                            <li><a href="/board/view/<%= bt.type_id %>/1"><%= bt.title %></a></li>
                        <% }) %>
                    <% } %>
                </ul>
            </li>

            <li>
                <div class="icon-link">
                    <a href="#">
                        <i class='bx bx-data'></i>
                        <span class="link_name">DB Admin</span>
                    </a>
                    <i class='bx bxs-chevron-down arrow'></i>
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">DB Admin</a></li>
                    <li><a href="/code/view">code CRUD</a></li>
                    <li><a href="/product/view">product CRUD</a></li>
                    <li><a href="/person/view">person CRUD</a></li>
                    <% if (cls === 'MNG' ||  cls === 'CEO') { %>
                        <li><a href="/board/type/view">board type CRUD</a></li>
                    <% } %>
                </ul>
            </li>

            <li>
                <div class="icon-link">
                    <a href="#">
                        <i class='bx bx-cog'></i>
                        <span class="link_name">Setting</span>
                    </a>
                    <i class='bx bxs-chevron-down arrow'></i>
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Setting</a></li>
                    <li><a href="<%= (who !== 'Guest') ? '#' : '/auth/register' %>">회원 가입</a></li>
                    <li><a href="#">아이디 비번 찾기</a></li>
                </ul>
            </li>

            <li>
                <div class="profile-details">
                    <div class="profile-content">
                        <i class='bx bx-user-circle' style="font-size: 50px;"></i>
                    </div>
                    <div class="name-job">
                        <div class="profile_name"><%= who %></div>
                        <div class="job"><%= cls %></div>
                    </div>
                    <%- login %>
                </div>
            </li>
        </ul>
    </div>

    <section class="home-section">
        <div class="home-content">
            <i class='bx bx-menu'></i>
            <span class="text">Drop Down Sidebar 202235318 장영민</span>
        </div>
        <div class="home-content2">
            <%- include(body) %>
        </div>
    </section>

    <script>
        let arrow = document.querySelectorAll(".arrow");
        for (var i = 0; i < arrow.length; i++) {
            arrow[i].addEventListener("click", (e)=>{
                let arrowParent = e.target.parentElement.parentElement;
                arrowParent.classList.toggle("showMenu");
            });
        }
        let sidebar = document.querySelector(".sidebar");
        let sidebarBtn = document.querySelector(".bx-menu");
        sidebarBtn.addEventListener("click", ()=>{
            sidebar.classList.toggle("close");
        });
    </script>
</body>
</html>
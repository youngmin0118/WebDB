<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header table-primary fw-bold text-dark">
            <i class="bx bx-credit-card-front"></i> 구매 내역 및 수량 선택
        </div>
        <div class="card-body p-4">
            <% if (typeof result !== 'undefined' && result) { %>
                <form action="/purchase/pay_process" method="POST" class="m-0">
                    <input type="hidden" name="prod_id" value="<%= result.prod_id %>">
                    <input type="hidden" name="price" value="<%= result.price %>">

                    <table class="table table-bordered align-middle m-0">
                        <tr>
                            <td rowspan="6" style="width: 340px; text-align: center;" class="bg-light">
                                <% if (result.image) { %>
                                    <img src="/images/<%= result.image %>" style="width:300px; height:300px; object-fit: cover;" class="rounded border shadow-sm">
                                <% } else { %>
                                    <div class="d-flex flex-column justify-content-center align-items-center rounded border bg-white" style="width:300px; height:300px;">
                                        <i class="bx bx-image-alt fs-1 text-muted mb-2"></i>
                                        <span class="text-muted" style="font-size: 0.85rem;">이미지 없음</span>
                                    </div>
                                <% } %>
                            </td>
                            <td class="p-3 bg-light-subtle">
                                <h3 class="fw-bold m-0 text-dark"><%= result.name %></h3>
                            </td>
                        </tr>
                        <tr> 
                            <td class="p-3">
                                <span class="text-secondary fw-semibold">가격 : </span> 
                                <span class="text-danger fs-4 fw-bold">
                                    <%= result.price ? result.price.toLocaleString() : 0 %>
                                </span> 원
                            </td>
                        </tr>
                        <tr> 
                            <td class="p-3">
                                <span class="text-secondary fw-semibold">브랜드 : </span> 
                                <span class="text-dark fw-medium"><%= result.brand %></span>
                            </td>
                        </tr>

                        <tr> 
                            <td class="p-3">
                                <span class="text-secondary fw-semibold">공급업체 : </span> 
                                <span class="text-dark fw-medium"><%= result.supplier ? result.supplier : '가천숍' %></span>
                            </td>
                        </tr>

                        <% if (cls === 'CST') { %>
                            <tr> 
                                <td class="p-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <label for="qty" class="text-secondary fw-semibold" style="min-width: 60px;">수량 : </label>
                                        <input type="number" id="qty" name="qty" class="form-control" value="1" min="1" style="width: 100px;" required>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-3 bg-light-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <button class="btn btn-success px-4 shadow-sm" type="submit">
                                            <i class="bx bx-check-circle"></i> 결제하기
                                        </button>

                                        <button class="btn btn-outline-primary px-4" type="submit" formdataaction="/purchase/cart_process">
                                            <i class="bx bx-cart"></i> 장바구니
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% } else { %>
                            <tr>
                                <td class="p-3 bg-light-subtle text-muted" style="font-size: 0.9rem;">
                                    <span class="text-secondary fw-semibold"></span> 
                                </td>
                            </tr>
                        <% } %>
                    </table>
                </form>

                <div class="mt-3 text-end">
                    <a href="/" class="btn btn-outline-secondary px-3" style="text-decoration: none;">
                        <i class="bx bx-home"></i> 메인화면으로 복귀
                    </a>
                </div>

            <% } else { %>
                <div class="text-center py-5">
                    <i class="bx bx-error-circle fs-1 text-danger mb-2"></i>
                    <p class="text-muted mb-0">상품 데이터를 정상적으로 불러오지 못했습니다.</p>
                    <a href="/" class="btn btn-primary btn-sm mt-3">홈으로 이동</a>
                </div>
            <% } %>
        </div>
    </div>
</div>
<div class="container" style="max-width: 600px; margin-top: 30px;">	
    <%
        
        var isUpdate = (typeof boardtype !== 'undefined');
        var titleText = isUpdate ? '게시판 수정' : '게시판 생성';
        var actionUrl = isUpdate ? '/board/type/update_process' : '/board/type/create_process';

        
        var writeY = "";
        var writeN = "checked"; // 생성 시 기본값 No
        if (isUpdate && boardtype.write_YN === 'Y') {
            writeY = "checked"; writeN = "";
        }

        var reY = "";
        var reN = "checked"; // 생성 시 기본값 No
        if (isUpdate && boardtype.re_YN === 'Y') {
            reY = "checked"; reN = "";
        }
    %>
    
    <h2 class="mb-4"><%= titleText %></h2>
    <form action="<%= actionUrl %>" method="post">
        <% if (isUpdate) { %>
            <input type="hidden" name="type_id" value="<%= boardtype.type_id %>">
        <% } %>

        <div class="mb-3">
            <label class="form-label" style="font-weight: bold;">제목</label> 
            <input class="form-control" type="text" name="title" 
                   value="<%= isUpdate ? boardtype.title : '' %>" required />
        </div>

        <div class="mb-3">
            <label class="form-label" style="font-weight: bold;">설명</label> 
            <input class="form-control" type="text" name="description" 
                   value="<%= isUpdate ? boardtype.description : '' %>" />
        </div>

        <div class="mb-3">
            <label class="form-label" style="font-weight: bold;">페이지당 보여지는 글 수</label> 
            <input class="form-control" type="number" name="numPerPage" 
                   value="<%= isUpdate ? boardtype.numPerPage : '2' %>" required />
        </div>
        
        <label class="form-label" style="font-weight: bold;">일반 사용자 쓰기 가능 여부</label>
        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="write_YN" id="write_YN1" value="Y" <%= writeY %>>
                <label class="form-check-label" for="write_YN1"> Yes </label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="write_YN" id="write_YN2" value="N" <%= writeN %>>
                <label class="form-check-label" for="write_YN2"> No </label>
            </div>
        </div>

        <label class="form-label" style="font-weight: bold;">댓글 가능 여부</label> 
        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="re_YN" id="re_YN1" value="Y" <%= reY %>>
                <label class="form-check-label" for="re_YN1"> Yes </label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="re_YN" id="re_YN2" value="N" <%= reN %>>
                <label class="form-check-label" for="re_YN2"> No </label>
            </div>
        </div>

        <div class="mt-4">
            <button class="btn btn-outline-primary btn-sm" type="submit"><%= isUpdate ? '수정' : '생성' %></button>
            <a href="/board/type/view" class="btn btn-outline-secondary btn-sm">취소</a>
        </div>
    </form>
</div>
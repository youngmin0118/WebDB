<div class="container" style="max-width: 750px; margin-top: 30px;">
    <h3 class="mb-4 fw-bold" style="color: #333;">게시글 상세보기</h3>
    
    <div class="card p-4 shadow-sm border-0 bg-white rounded-3">
        <div class="mb-3 border-bottom pb-3">
            <h4 class="fw-bold text-dark mb-2"><%= results[0].title %></h4>
            <div class="d-flex text-secondary gap-3" style="font-size: 0.9rem;">
                <div><i class="bx bx-user"></i> 작성자: <strong><%= results[0].author_name || '익명' %></strong></div>
                <div>|</div>
                <div><i class="bx bx-calendar"></i> 작성일: <%= results[0].date %></div>
            </div>
        </div>
        
        <div class="mb-5 py-2 text-dark" style="min-height: 250px; white-space: pre-wrap; line-height: 1.6; font-size: 1.05rem;">
            <%= results[0].content %>
        </div>
        
        <div class="d-flex justify-content-between border-top pt-3">
            <div>
                <a href="/board/view/<%= results[0].type_id %>/<%= pNum %>" class="btn btn-outline-secondary px-4 shadow-sm">
                    <i class="bx bx-list-ul"></i> 목록으로
                </a>
            </div>
            
            <div class="d-flex gap-2">
                <% if (cls === 'MNG' || (typeof who_id !== 'undefined' && who_id === results[0].loginid)) { %>
                    <a href="/board/update/<%= results[0].board_id %>/<%= results[0].type_id %>/<%= pNum %>" 
                       class="btn btn-warning text-white px-4 shadow-sm">
                        <i class="bx bx-edit"></i> 수정
                    </a>
                    <a href="/board/delete/<%= results[0].board_id %>/<%= results[0].type_id %>/<%= pNum %>" 
                       class="btn btn-danger px-4 shadow-sm" 
                       onclick="return confirm('정말로 이 게시글을 삭제하시겠습니까?')">
                        <i class="bx bx-trash"></i> 삭제
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</div>
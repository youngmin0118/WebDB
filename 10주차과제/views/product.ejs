<div class="container" style="margin-top: 30px;">
    <h2 class="mb-4">상품 관리</h2>
    
    <table class="table table-bordered align-middle" style="text-align: center;">
        <thead class="table-primary">
            <tr>
                <th>상품 이미지</th>
                <th>상품명</th>
                <th>가격</th>
                <th>브랜드</th>
                <% if (cls === 'admin') { %>
                    <th colspan="2">관리</th> 
                <% } %>
            </tr>
        </thead> 
        <tbody>
            <% if (results && results.length > 0) { %>
                <% for(var i = 0; i < results.length; i++) { %>
                    <tr>
                        <td>
                            <img src="/images/<%= results[i].image %>" 
                                 style="width:100px; height:100px; object-fit: cover; border-radius: 5px;"
                                 alt="<%= results[i].name %>">
                        </td>
                        <td><%= results[i].name %></td>
                        <td><%= results[i].price.toLocaleString() %>원</td>
                        <td><%= results[i].brand %></td>
                        
                        <% if (cls === 'admin') { %>
                            <td>
                                <a href="/product/update/<%= results[i].id %>" class="btn btn-sm btn-outline-primary">수정</a>
                            </td>
                            <td>
                                <a href="/product/delete/<%= results[i].id %>" 
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('정말로 삭제하시겠습니까?')">삭제</a>
                            </td>
                        <% } %>
                    </tr>
                <% } %>
            <% } else { %>
                <tr>
                    <td colspan="<%= (cls === 'admin') ? 6 : 4 %>" class="py-4 text-secondary">등록된 상품이 없습니다.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <% if (cls === 'admin') { %>
        <div class="mt-3">
            <a href="/product/create" class="btn btn-outline-secondary btn-sm">상품 추가</a>
        </div>
    <% } %>
</div>
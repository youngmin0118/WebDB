<div class="container" style="margin-top: 30px;">
    <h2 class="mb-4">회원 관리 (Admin)</h2>
    
    <table class="table table-bordered border-primary table-hover" style="text-align: center;">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>이름</th>
                <th>성별</th>
                <th>주소</th>
                <th>전화번호</th>
                <th>생일</th>
                <th>클래스</th>
                <th colspan="2">메뉴</th>
            </tr>
        </thead> 
        <tbody>
            <% if (results && results.length > 0) { %>
                <% for(var i = 0; i < results.length; i++) { %>
                    <tr>
                        <td><%= results[i].loginid %></td>
                        <td><%= results[i].name %></td>
                        <td><%= (results[i].mf === 'M' || results[i].mf === 'm') ? '남자' : '여자' %></td>
                        <td><%= results[i].address %></td>
                        <td><%= results[i].tel %></td>
                        <td><%= results[i].birth %></td>
                        <td>
                            <%= results[i].class %>
                            <% if(results[i].class === 'CST') { %>(고객)<% } %>
                            <% if(results[i].class === 'MNG') { %>(관리자)<% } %>
                            <% if(results[i].class === 'CEO') { %>(경영자)<% } %>
                        </td>
                        <td>
                            <a href="/person/update/<%= results[i].loginid %>" class="btn btn-sm btn-outline-success">수정</a>
                        </td>
                        <td>
                            <a href="/person/delete/<%= results[i].loginid %>" 
                               class="btn btn-sm btn-outline-danger" 
                               onclick="return confirm('정말로 삭제하시겠습니까?')">삭제</a>
                        </td>
                    </tr>
                <% } %>
            <% } else { %>
                <tr>
                    <td colspan="9" class="py-4 text-secondary text-center">등록된 회원이 없습니다.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <div class="mt-3 text-start">
        <a href="/person/create" class="btn btn-sm btn-outline-secondary">고객 추가</a>
    </div>
</div>